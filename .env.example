# eventwake reads no environment variables of its own. Values here are only used through
# ${VAR} / ${VAR:-default} expansion in server definitions, for example:
#
#   [servers.incidents]
#   type = "http"
#   url = "https://mcp.example.com/mcp"
#   headers = { Authorization = "Bearer ${INCIDENTS_MCP_TOKEN}" }
#
# An unset variable makes eventwake refuse to start that server, rather than send an empty
# credential. Export these in your shell or service unit. eventwake does not read this file.
INCIDENTS_MCP_TOKEN=
